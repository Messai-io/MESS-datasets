# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real keys.

# Zenodo personal access token — OPTIONAL.
# Anonymous API works fine for this repo's scale (60 req/min, 2000/hour).
# Create a token at https://zenodo.org/account/settings/applications/
# if you need higher limits or access to unpublished records.
# ZENODO_TOKEN=
