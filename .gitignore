# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
*.key
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Logs / coverage
*.log
coverage/

# Large intermediate dataset artifacts — stage under data/.cache/
data/.cache/

# Per-record raw source sidecar — gitignored, lives alongside committed metadata
data/**/.source/

# Large archive formats in committed files/ dirs (raw source belongs in .source/)
data/**/files/*.zip
data/**/files/*.tar.gz
data/**/files/*.tar.bz2
data/**/files/*.tar.xz
data/**/files/*.7z
data/**/files/*.rar

# Misc
.claude/
.claude-flow/
